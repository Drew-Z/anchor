# OpenAI API Key (必需)
OPENAI_API_KEY=sk-your-key-here

# OpenAI 模型选择
# 可选: gpt-3.5-turbo (便宜快速) 或 gpt-4-turbo (质量更高)
OPENAI_MODEL=gpt-3.5-turbo

# OpenAI API Base URL (可选,用于本地模型)
# 例如 Ollama: http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# 日志级别
# 可选: debug, info, warning, error
LOG_LEVEL=info

# 题目生成配置
# 每个知识点生成的题目数量
QUESTIONS_PER_KNOWLEDGE_POINT=2

# 最大知识点数量
MAX_KNOWLEDGE_POINTS=50

# Citation 验证置信度阈值 (0.0-1.0)
CITATION_CONFIDENCE_THRESHOLD=0.8

# Question 验证置信度阈值 (0.0-1.0)
QUESTION_VALIDATION_THRESHOLD=0.7
